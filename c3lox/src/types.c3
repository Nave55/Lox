module c3lox;

alias Uint8 = char; // uint8_t / char
alias Int8 = ichar; // int8_t
alias Uint16 = ushort; // uint16_t
alias Int16 = short; // short / int16_t
alias Uint32 = uint; // uint32_t
alias Int32 = int; // int / long / int32_t
alias Uint64 = ulong; // uint64_t
alias Int64 = long; // long long

alias BinaryFn = fn double(double, double);